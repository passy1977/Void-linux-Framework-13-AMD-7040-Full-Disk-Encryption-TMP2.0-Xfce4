#!/bin/bash

# Default desktop user for daemon-triggered notifications.
# Can be overridden by setting NOTIFY_USER in the environment before calling this script.
DEFAULT_NOTIFY_USER="johndoe"

# Determine the target user for the desktop notification.
# When run as root or another non-desktop user, fall back to the default and log it.
if [ "${USER:-root}" = "$DEFAULT_NOTIFY_USER" ]; then
    TARGET_USER="$DEFAULT_NOTIFY_USER"
else
    logger -p daemon.warning "sendmail-fake: invoked as user '${USER:-root}', falling back to default notify user '$DEFAULT_NOTIFY_USER'"
    TARGET_USER="$DEFAULT_NOTIFY_USER"
fi

MESSAGE=$(cat)

# Maximum number of body lines to include in the notification
MAX_BODY_LINES=7

# Check if message has email headers (contains "Subject:" or other headers)
if printf '%s' "$MESSAGE" | grep -q -i '^[A-Za-z-]*:[[:space:]]'; then
    # Email format: extract subject and body
    SUBJECT=$(printf '%s' "$MESSAGE" | grep -i '^Subject:' | head -1 | sed 's/^[Ss]ubject:[[:space:]]*//')
    BODY=$(printf '%s' "$MESSAGE" | sed -n '/^$/,$ p' | sed '1d' | head -n "$MAX_BODY_LINES")
    [ -z "$SUBJECT" ] && SUBJECT="Sendmail message"
else
    # Plain text: use first line as subject, rest as body
    SUBJECT=$1
    if [ -z "$SUBJECT" ]; then
        SUBJECT="Sendmail message"
    fi
    BODY=$(printf '%s' "$MESSAGE" | tail -n +2 | head -n "$MAX_BODY_LINES")
fi

# If body is still empty, use the whole message
if [ -z "$BODY" ]; then
    BODY=$(printf '%s' "$MESSAGE" | head -n "$MAX_BODY_LINES")
fi


# Find the DBUS session bus address from the running user session
USER_PID=$(pgrep -u "$TARGET_USER" xfce4-session 2>/dev/null | head -1)
if [ -z "$USER_PID" ]; then
    USER_PID=$(pgrep -u "$TARGET_USER" xfce4-notifyd 2>/dev/null | head -1)
fi

if [ -n "$USER_PID" ]; then
    DBUS_ADDR=$(grep -z DBUS_SESSION_BUS_ADDRESS /proc/$USER_PID/environ 2>/dev/null | tr '\0' '\n' | grep DBUS_SESSION_BUS_ADDRESS | cut -d= -f2-)
fi

# Fallback to static path
if [ -z "$DBUS_ADDR" ]; then
    DBUS_ADDR="unix:path=/run/user/$(id -u "$TARGET_USER")/bus"
fi



sudo -u "$TARGET_USER" \
    DISPLAY=:0 \
    DBUS_SESSION_BUS_ADDRESS="$DBUS_ADDR" \
    notify-send -t 2500 "$SUBJECT" "$BODY" --icon=dialog-information -u normal

exit 0
